# Cloud Kitchen — environment variables
#
# This game is fully client-side. No environment variables are required to run it.
# The variables below are OPTIONAL and only used if you wire up an external
# share backend for level codes. None of them are secrets; they are public
# configuration values. Do not put any private key or token here.

# Optional: public base URL for a level-share endpoint (not used by default build).
# If set, the level builder's "share" button POSTs a level JSON to this URL.
# Example: https://your-share-endpoint.example.com/api/levels
VITE_LEVEL_SHARE_ENDPOINT=

# Optional: public site URL used for the shareable level link canonical host.
# Example: https://cloud-kitchen.example.com
VITE_PUBLIC_BASE_URL=
